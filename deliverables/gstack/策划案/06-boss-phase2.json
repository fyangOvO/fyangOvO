  "arena_change_spec": {
    "_note": "S11 新增系统。两种场地变化可叠加，但叠加时有硬约束，必须给 assert。",
    "effects": [
      {
        "id": "fire_ring",
        "name": "地面火环",
        "element": "fire",
        "semantics": "场地外圈持续火伤，周期性向中心收缩",
        "affected_zone": "距场地中心 > R_inner 的环带",
        "params": {
          "R_initial": "战场半径 × 0.9",
          "R_inner_final": "战场半径 × 0.35",
          "shrink_duration_sec": 12.0,
          "tick_interval_sec": 0.5,
          "damage_per_tick_pct_max_hp": 0.015
        },
        "timing": "独立计时，不受 shrink_arena 影响"
      },
      {
        "id": "shrink_arena",
        "name": "缩小战场",
        "element": null,
        "semantics": "战场可走区域半径随时间收缩，视觉为暗色边界内推",
        "affected_zone": "全局 R_arena",
        "params": {
          "R_start": "战场半径 × 1.0",
          "R_arena_final": "战场半径 × 0.45",
          "shrink_duration_sec": 15.0
        },
        "timing": "独立计时"
      }
    ],
    "stacking_constraint": {
      "_critical": true,
      "rule": "R_inner（火环内沿）必须 >= R_arena（缩小后的战场半径）",
      "why": "否则火环会烧在整个战场内侧 ⇒ 玩家无处可站 ⇒ 【不可通过的 BOSS】",
      "suggested_assert": "assert(fire_ring_inner_radius >= arena_radius_at_end, \"火环内沿不得小于战场半径，否则 BOSS 不可通过\")",
      "safe_zone_semantics": "叠加时安全区 = min(R_inner, R_arena)",
      "recommended_values": {
        "safe_margin_px": 24,
        "note": "R_inner_final(0.35) < R_arena_final(0.45) ⇒ ⚠️ 冲突！建议改为 R_inner_final = 0.50 或 R_arena_final = 0.30，保证 R_inner >= R_arena。"
      }
    }
  },

