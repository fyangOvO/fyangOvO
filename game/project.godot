; Engine configuration file.
; 「七傳說」—— 暗黑类刷宝 ARPG（纯单机 / 2D 俯视 / 像素风）
;
; 本文件为 Godot 4.x 项目配置。手写维护，请在 Godot 编辑器中改动后核对本文件差异。
;
; 关键规格（对应 GDD 阶段 0）：
;   - 视口 1920×1080，窗口化，拉伸模式 canvas_items（像素完美 + UI 自适应）
;   - 默认纹理过滤 Nearest（像素风铁律，禁止线性插值糊化精灵）
;   - 渲染器 GL Compatibility（2D 场景性能与硬件兼容性最佳）
;
; 注意：本文件中的 Input Map 使用 physical_keycode，
;       保证 WASD 在任意键盘布局下都落在相同的物理位置。

config_version=5

[application]

config/name="七傳說"
config/description="纯单机 2D 俯视刷宝 ARPG。局内三选一成长 + 局外装备锻造双线养成。"
config/version="0.1.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.051, 0.063, 1)

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
ConfigLoader="*res://scripts/autoload/config_loader.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"
InputRemapper="*res://scripts/core/input_remapper.gd"
JuiceFX="*res://scripts/juice/juice_fx.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[file_customization]

folder_colors={
"res://assets/": "green",
"res://data/": "yellow",
"res://resources/": "purple",
"res://scenes/": "blue",
"res://scripts/": "red"
}

