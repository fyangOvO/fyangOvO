    "multiplier_pct",
    "cooldown_pct",
    "mana_cost_pct",
    "radius_pct",
    "range_pct"
   ],
   "乘算修饰口径（第二步 §7.4 统一，2026-09-24）": "所有 *_pct 均为【带符号增量】：正值 = 延长/增大，负值 = 缩短/减小。例：cooldown_pct: -20 表示冷却缩短 20%。与工程侧 cooldown_reduction / skill_cost_reduction 的换算：total_reduction = gear_reduction - rune_pct_sum。工程侧两个 *_reduction 键按百分数正向累加，硬顶 70%。",
   "附加效果": [
    "stun_chance",
    "stun_duration",
    "life_leech_pct",
    "shield_pct_hp",
    "mana_restore_pct",
    "echo_count",
    "echo_damage_pct",
    "area_bonus_pct",
    "on_hit_slow",
    "on_hit_burn",
    "on_hit_split",
    "execute",
    "opener",
    "combo_hits",
    "combo_damage_pct"
   ]
  }
 },
